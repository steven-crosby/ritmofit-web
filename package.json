{
  "name": "ritmofit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.4.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @ritmofit/api dev",
    "dev:web": "pnpm --filter @ritmofit/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @ritmofit/web build && pnpm --filter @ritmofit/e2e e2e",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "audit:ci": "pnpm audit --prod",
    "tasks": "node scripts/tasks.mjs",
    "tasks:render": "node scripts/tasks.mjs render",
    "tasks:check": "node scripts/tasks.mjs check",
    "tasks:test": "node --test scripts/tasks.test.mjs",
    "owner-gate:test": "node --test scripts/owner-gate.test.mjs",
    "rf-trace:test": "node --test scripts/rf-trace.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  }
}
